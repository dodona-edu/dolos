# The release of the Dolos images. All images use the same release.
DOLOS_VERSION=3.0.0

# The address of Dolos in the browser.
# On a server, set DOLOS_PROTOCOL=https and DOLOS_HOST to the domain name of the server.
# Caddy then gets a certificate for this domain name. Ports 80 and 443 must be reachable from the internet.
# On your own computer, keep DOLOS_PROTOCOL=http and DOLOS_HOST=localhost.
DOLOS_PROTOCOL=http
DOLOS_HOST=localhost

# Database user.
DATABASE_USER=dolos

# Secrets. They have no default value. Generate them with:
#   DATABASE_PASSWORD: openssl rand -hex 32
#   SECRET_KEY_BASE:   openssl rand -hex 64
DATABASE_PASSWORD=
SECRET_KEY_BASE=

# The Docker socket. The worker uses it to start a CLI container for each analysis.
# For a rootless Docker setup, use ${XDG_RUNTIME_DIR}/docker.sock
DOCKER_SOCKET=/var/run/docker.sock
