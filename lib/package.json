  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsc --build && ava",
    "test:watch": "ava --watch",
    "build": "tsc --build --verbose",
    "force-build": "tsc --build --verbose --force",
    "lint": "eslint src/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodona-edu/dolos.git"
  },
