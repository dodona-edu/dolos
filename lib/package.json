  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@ava/typescript": "7.0.0",
    "@types/d3-dsv": "3.0.7",
    "@types/node": "^26.6.5",
    "ava": "^8.0.2",
    "typescript-eslint": "^8.71.2" ,
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@dodona/dolos-parsers": "1.5.0",
    "@dodona/dolos-core": "1.2.2",
    "d3-dsv": "^3.0.1",
    "tree-sitter": "^0.25.1"
  },
  "bugs": {
    "url": "https://github.com/dodona-edu/dolos/issues"
  },
  "homepage": "https://dolos.ugent.be",
